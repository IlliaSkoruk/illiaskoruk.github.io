---
import { navItems } from '../data/navigation';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Основна зона з трьома колонками -->
    <div class="footer-main">
      <!-- Зона A — Інформація про проєкт -->
      <div class="footer-col footer-about">
        <a href="/" class="footer-logo" aria-label="Firearms Explorer — на головну сторінку">
          Firearms Explorer
        </a>
        <p class="footer-tagline">
          Сучасний інформаційний портал про стрілецьку зброю, аксесуари, технології, збройові платформи та оснащення сучасних армій.
        </p>
      </div>

      <!-- Зона B — Навігація -->
      <div class="footer-col footer-nav-col">
        <h3 class="footer-heading">Розділи</h3>
        <nav aria-label="Навігація у підвалі сайту">
          <ul class="footer-nav-list">
            {
              navItems.map((item) => (
                <li class="footer-nav-item">
                  <a href={item.href} class="footer-nav-link">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <!-- Зона C — Інформаційний дисклеймер -->
      <div class="footer-col footer-disclaimer">
        <h3 class="footer-heading">Про ресурс</h3>
        <p class="footer-disclaimer-text">
          Firearms Explorer — виключно інформаційний та освітній ресурс. Матеріали не є юридичною
          консультацією чи порадами практичного застосування. Усі правові вимоги та класифікацію
          слід перевіряти за офіційними джерелами відповідної юрисдикції. Ресурс не є магазином
          і не здійснює продаж зброї чи аксесуарів.
        </p>
      </div>
    </div>

    <!-- Нижній рядок -->
    <div class="footer-bottom">
      <div class="footer-bottom-inner">
        <p class="footer-copyright">
          &copy; {currentYear} Firearms Explorer
        </p>
        <p class="footer-badge">
          Інформаційно-освітній проєкт
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* =========================================================
     Footer — Dark Graphite
     ========================================================= */
  .site-footer {
    background-color: var(--color-dark-canvas);
    color: var(--color-dark-text-secondary);
    border-top: 1px solid var(--color-dark-border);
    margin-top: auto;
  }

  .footer-container {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* Основна сітка */
  .footer-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-dark-border);
  }

  @media (min-width: 640px) and (max-width: 959px) {
    .footer-main {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl) var(--space-lg);
    }
    .footer-disclaimer {
      grid-column: span 2;
    }
  }

  @media (min-width: 960px) {
    .footer-main {
      grid-template-columns: 1.2fr 0.8fr 1.4fr;
      gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  /* ---- Зона A: Логотип та слоган ---- */
  .footer-logo {
    font-size: 1.125rem;
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    color: var(--color-dark-text);
    text-decoration: none;
    display: inline-block;
    margin-bottom: var(--space-xs);
    transition: color 0.15s ease;
  }

  .footer-logo:hover {
    color: var(--color-accent-light);
  }

  .footer-logo:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-dark-text-secondary);
    margin: 0;
    max-width: 340px;
  }

  /* ---- Зона B: Навігація ---- */
  .footer-heading {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-dark-text);
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .footer-nav-item {
    margin: 0;
  }

  .footer-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.2rem 0;
    font-size: var(--text-sm);
    color: var(--color-dark-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav-link:hover {
    color: var(--color-dark-text);
  }

  .footer-nav-link:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* ---- Зона C: Дисклеймер ---- */
  .footer-disclaimer-text {
    font-size: var(--text-xs);
    line-height: var(--leading-relaxed);
    color: var(--color-dark-text-muted);
    margin: 0;
  }

  /* ---- Нижній рядок ---- */
  .footer-bottom {
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-copyright {
    font-size: var(--text-xs);
    color: var(--color-dark-text-muted);
    margin: 0;
  }

  .footer-badge {
    font-size: var(--text-xs);
    color: var(--color-dark-text-muted);
    margin: 0;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
</style>
