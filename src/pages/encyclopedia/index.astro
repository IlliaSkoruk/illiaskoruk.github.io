---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../data/categories';

// Отримання лише опублікованих моделей (відокремлення чернеток)
const firearms = await getCollection('firearms', ({ data }) => !data.draft);
const hasModels = firearms.length > 0;
---

<BaseLayout
  title="Енциклопедія вогнепальної зброї — Firearms Explorer"
  description="Систематизований каталог, класифікація та конструктивні особливості історичних і сучасних зразків вогнепальної зброї."
>
  <!-- 1. ВЕРХНЯ СЕКЦІЯ (HERO РІВНЯ РОЗДІЛУ) -->
  <section class="encyclopedia-header-section" aria-labelledby="page-title">
    <div class="container">
      <div class="header-content">
        <div class="section-kicker" aria-hidden="true">
          <span class="kicker-line"></span>
          <span>ЕНЦИКЛОПЕДІЯ</span>
        </div>

        <h1 id="page-title" class="page-title">
          Енциклопедія вогнепальної зброї
        </h1>

        <p class="page-lead">
          Систематизований архів та аналітичний каталог зразків озброєння. Досліджуйте історію появи,
          конструктивні схеми, виробничі передумови та підтверджені технічні показники моделей різних епох.
        </p>

        <!-- Стриманий технічний декоративний елемент -->
        <div class="header-spec-bar" aria-hidden="true">
          <div class="spec-item">
            <span class="spec-label">МЕТОДОЛОГІЯ</span>
            <span class="spec-val">Першоджерела та патенти</span>
          </div>
          <div class="spec-divider"></div>
          <div class="spec-item">
            <span class="spec-label">КЛАСИФІКАЦІЯ</span>
            <span class="spec-val">6 базових категорій</span>
          </div>
          <div class="spec-divider"></div>
          <div class="spec-item">
            <span class="spec-label">СТАТУС КАТАЛОГУ</span>
            <span class="spec-val">{hasModels ? `Опубліковано ${firearms.length} моделей` : 'Наповнення бази знань'}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. СЕКЦІЯ КАТЕГОРІЙ -->
  <section class="categories-section" aria-labelledby="categories-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="categories-heading" class="section-title">
          Досліджуйте за категоріями
        </h2>
        <p class="section-desc">
          Систематизація зразків за конструктивними ознаками та призначенням дозволяє простежити еволюцію
          інженерних рішень від ранніх систем до сучасної високоточної автоматики.
        </p>
      </div>

      <div class="categories-grid">
        {
          CATEGORIES.map((cat, index) => (
            <div class="category-card surface">
              <div class="category-card-top">
                <span class="category-pill">Категорія</span>
                <span class="category-index">0{index + 1}</span>
              </div>
              <h3 class="category-title">{cat.name}</h3>
              <p class="category-description">{cat.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. СЕКЦІЯ КАТАЛОГУ МОДЕЛЕЙ -->
  <section class="catalog-section" aria-labelledby="catalog-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="catalog-heading" class="section-title">
          Каталог моделей
        </h2>
        <p class="section-desc">
          Структурована база знань із детальними паспортами зразків, технічними параметрами та переліком першоджерел.
        </p>
      </div>

      {
        hasModels ? (
          <div class="models-grid">
            {firearms.map((item) => (
              <article class="model-card surface">
                <div class="model-card-header">
                  <span class="model-category">{item.data.category}</span>
                  {item.data.introducedYear && (
                    <span class="model-year">{item.data.introducedYear} р.</span>
                  )}
                </div>
                <h3 class="model-title">{item.data.title}</h3>
                {item.data.originalName && (
                  <p class="model-original-name">{item.data.originalName}</p>
                )}
                <p class="model-summary">{item.data.summary}</p>
              </article>
            ))}
          </div>
        ) : (
          /* Елегантний порожній стан на основі реальних даних колекції */
          <div class="empty-state-card surface">
            <div class="empty-state-badge" aria-hidden="true">
              АРХІВНЕ ОПРАЦЮВАННЯ
            </div>
            <h3 class="empty-state-title">Каталог на стадії наповнення</h3>
            <p class="empty-state-text">
              Каталог поступово наповнюється перевіреними матеріалами. Незабаром тут з'являться енциклопедичні сторінки моделей.
            </p>
            <div class="empty-state-meta" aria-hidden="true">
              <span class="meta-tag">Верифікація джерел</span>
              <span class="meta-sep">•</span>
              <span class="meta-tag">Атрибутовані характеристики</span>
              <span class="meta-sep">•</span>
              <span class="meta-tag">Історичний контекст</span>
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     1. ВЕРХНЯ СЕКЦІЯ РОЗДІЛУ
     ========================================================================== */
  .encyclopedia-header-section {
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
  }

  .header-content {
    max-width: 820px;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }

  .kicker-line {
    width: 20px;
    height: 2px;
    background-color: var(--color-accent);
    display: inline-block;
  }

  .page-title {
    font-size: var(--text-4xl);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .page-lead {
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
  }

  /* Стриманий технічний інформаційний рядок */
  .header-spec-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .spec-label {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .spec-val {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .spec-divider {
    display: none;
    width: 1px;
    height: 28px;
    background-color: var(--color-border-subtle);
  }

  @media (min-width: 640px) {
    .spec-divider {
      display: block;
    }
  }

  /* ==========================================================================
     2. СЕКЦІЯ КАТЕГОРІЙ
     ========================================================================== */
  .categories-section {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .section-intro {
    max-width: 720px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-title {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .section-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-bottom: 0;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease;
  }

  .category-card:hover {
    border-color: var(--color-border-strong);
  }

  .category-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .category-pill {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    background-color: rgba(72, 97, 84, 0.08);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .category-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .category-title {
    font-size: var(--text-xl);
    letter-spacing: -0.015em;
    margin-top: 0;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }

  .category-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* ==========================================================================
     3. СЕКЦІЯ КАТАЛОГУ ТА ПОРОЖНІЙ СТАН
     ========================================================================== */
  .catalog-section {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--color-border);
  }

  .empty-state-card {
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
    padding: clamp(2rem, 4vw, 3.5rem);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-subtle) 100%);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
  }

  .empty-state-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
  }

  .empty-state-title {
    font-size: var(--text-2xl);
    letter-spacing: -0.015em;
    margin-top: 0;
    margin-bottom: var(--space-xs);
    color: var(--color-text);
  }

  .empty-state-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    max-width: 580px;
    margin-inline: auto;
    margin-bottom: var(--space-lg);
  }

  .empty-state-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  .meta-tag {
    color: var(--color-text-secondary);
  }

  .meta-sep {
    color: var(--color-border-strong);
  }

  /* Сітка для майбутніх моделей */
  .models-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 640px) {
    .models-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .models-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
