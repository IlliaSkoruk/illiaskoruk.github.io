---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Енциклопедія — Firearms Explorer"
  description="Центральна база моделей, класифікація та конструктивні особливості вогнепальної зброї."
>
  <div class="container section">
    <div class="container-narrow">
      <h1>Енциклопедія</h1>
      <p class="text-secondary" style="font-size: var(--text-lg);">
        Центральна база моделей, класифікація, перевірені технічні характеристики та першоджерела.
      </p>

      <div class="surface-subtle" style="margin-top: var(--space-xl); display: inline-block;">
        <p style="margin: 0; color: var(--color-accent); font-weight: var(--weight-medium);">
          Розділ у розробці
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
