---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Історія — Firearms Explorer"
  description="Хронологія, епохи розвитку та історичний контекст створення вогнепальної зброї."
>
  <div class="container section">
    <div class="container-narrow">
      <h1>Історія</h1>
      <p class="text-secondary" style="font-size: var(--text-lg);">
        Історичний розвиток інженерної думки, епохи, хронологія ключових подій та архівні матеріали.
      </p>

      <div class="surface-subtle" style="margin-top: var(--space-xl); display: inline-block;">
        <p style="margin: 0; color: var(--color-accent); font-weight: var(--weight-medium);">
          Розділ у розробці
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
