---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  PLATFORM_TAXONOMY,
  PLATFORM_FAMILIES,
  MECHANICAL_STANDARDS,
  TECHNICAL_SOURCES,
} from '../../data/platformOverview';
---

<BaseLayout
  title="Платформи та сумісність — Firearms Explorer"
  description="Досліджуй сучасні збройові платформи, їхні сімейства, покоління та технічні інтерфейси. Зрозумілі пояснення стандартів, документація виробників і перевірені відомості про конструктивні відмінності."
>
  <!-- =========================================================================
       1. HERO СЕКЦІЯ (Dark Tactical Canvas)
       ========================================================================= -->
  <section class="platforms-hero" aria-labelledby="platforms-page-title">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="header-kicker" aria-hidden="true">
            <span class="kicker-bar"></span>
            <span>PLATFORMS / SYSTEMS / STANDARDS</span>
          </div>

          <h1 id="platforms-page-title" class="hero-title">
            Платформи та сумісність
          </h1>

          <p class="hero-lead">
            Досліджуй сучасні збройові платформи, їхні сімейства, покоління та технічні
            інтерфейси. Зрозумілі пояснення стандартів, документація виробників і перевірені
            відомості про конструктивні відмінності.
          </p>

          <div class="hero-actions">
            <a href="/encyclopedia/" class="hero-btn hero-btn-primary">
              <span class="btn-icon" aria-hidden="true">⊞</span>
              <span>Каталог зброї</span>
            </a>
            <a href="/accessories/" class="hero-btn hero-btn-secondary">
              <span class="btn-icon" aria-hidden="true">⚙</span>
              <span>Каталог аксесуарів</span>
            </a>
          </div>
        </div>

        <!-- Десктопна компактна інфо-панель з ключовими принципами -->
        <aside class="hero-side-panel" aria-label="Базові принципи сумісності">
          <div class="panel-header">
            <span class="panel-kicker">ТЕХНІЧНА АРХІТЕКТУРА</span>
            <span class="panel-badge">STANDARDS GUIDE</span>
          </div>
          <div class="panel-items">
            <div class="panel-item">
              <span class="panel-num">01</span>
              <div>
                <strong class="panel-term">Платформа</strong>
                <p class="panel-desc">Базова архітектурна схема та компоновка вузлів</p>
              </div>
            </div>
            <div class="panel-item">
              <span class="panel-num">02</span>
              <div>
                <strong class="panel-term">Модель</strong>
                <p class="panel-desc">Конкретний серійний виріб із фіксованими ТТХ</p>
              </div>
            </div>
            <div class="panel-item">
              <span class="panel-num">03</span>
              <div>
                <strong class="panel-term">Інтерфейс</strong>
                <p class="panel-desc">Стандартизоване механічне посадкове місце</p>
              </div>
            </div>
            <div class="panel-item">
              <span class="panel-num">04</span>
              <div>
                <strong class="panel-term">Документація</strong>
                <p class="panel-desc">Верифікація допусків за мануалами виробника</p>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. СЕКЦІЯ «ЩО ТАКЕ ЗБРОЙОВА ПЛАТФОРМА?» (Light Editorial Canvas)
       ========================================================================= -->
  <section class="section section-taxonomy" aria-labelledby="taxonomy-heading">
    <div class="container">
      <div class="section-header">
        <div class="section-tag" aria-hidden="true">КОНЦЕПЦІЯ ТА ТЕРМІНОЛОГІЯ</div>
        <h2 id="taxonomy-heading" class="section-heading">
          Що таке збройова платформа?
        </h2>
        <p class="section-lead">
          У збройовій індустрії нерідко виникає плутанина між загальною конструктивною платформою,
          конкретною серійною моделлю та категорією зброї. Для коректного розуміння сумісності важливо
          розрізняти рівні інженерної та редакційної класифікації.
        </p>
      </div>

      <!-- Редакційне роз'яснення меж класифікації -->
      <div class="disclaimer-banner" role="note" aria-label="Редакційне застереження щодо класифікації">
        <div class="disclaimer-badge">РЕДАКЦІЙНА КЛАСИФІКАЦІЯ</div>
        <p class="disclaimer-text">
          <strong>Зверніть увагу:</strong> редакційна класифікація Firearms Explorer є структурованою
          навчально-довідковою системою, покликаною впорядкувати технічні знання для стрільців та аналітиків,
          і не претендує на статус формального міжнародного договору. Наприклад, не слід ототожнювати
          <strong>AR-15</strong> як загальну відкриту платформу з конкретною заводською моделлю
          <strong>Daniel Defense DDM4 V7</strong>, створеною за цією схемою окремим виробником.
        </p>
      </div>

      <!-- Сітка понять: платформа, категорія, виробник, модель, покоління, модифікація -->
      <div class="taxonomy-grid">
        {
          PLATFORM_TAXONOMY.map((item) => (
            <article class="taxonomy-card">
              <div class="card-kicker-row">
                <span class="card-kicker">{item.englishTerm}</span>
              </div>
              <h3 class="taxonomy-card-title">{item.term}</h3>
              <p class="taxonomy-card-def">{item.definition}</p>
              <div class="taxonomy-example">
                <span class="example-label">Приклад:</span>
                <span class="example-text">{item.example}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. СЕКЦІЯ «ОСНОВНІ ПЛАТФОРМИ ТА СІМЕЙСТВА»
       ========================================================================= -->
  <section class="section section-families" aria-labelledby="families-heading">
    <div class="container">
      <div class="section-header">
        <div class="section-tag" aria-hidden="true">КОНСТРУКТИВНІ СІМЕЙСТВА</div>
        <h2 id="families-heading" class="section-heading">
          Основні платформи
        </h2>
        <p class="section-lead">
          Ключові конструктивні родини сучасної стрілецької зброї, навколо яких формуються
          ринки аксесуарів, компоненти модернізації та стандарти оснащення провідних армій.
        </p>
      </div>

      <div class="families-grid">
        {
          PLATFORM_FAMILIES.map((fam) => (
            <article class={`family-card ${fam.status === 'draft' ? 'family-card-draft' : ''}`}>
              <div class="family-top">
                <span class={`family-tag ${fam.status === 'draft' ? 'family-tag-draft' : ''}`}>
                  {fam.tag}
                </span>
                {fam.status === 'draft' && (
                  <span class="future-badge" aria-label="Статус матеріалу">
                    Матеріал готується
                  </span>
                )}
              </div>

              <h3 class="family-title">{fam.title}</h3>
              <p class="family-subtitle">{fam.subtitle}</p>
              <p class="family-desc">{fam.description}</p>

              <!-- Ключові конструктивні риси -->
              <div class="family-attributes" aria-label="Ключові особливості">
                {fam.keyAttributes.map((attr) => (
                  <span class="attr-pill">{attr}</span>
                ))}
              </div>

              <!-- Блок прикладу моделі або майбутнього матеріалу -->
              {fam.exampleModel ? (
                <div class="family-link-box">
                  <div class="link-box-header">
                    <span class="link-box-badge">МАТЕРІАЛ В ЕНЦИКЛОПЕДІЇ</span>
                  </div>
                  <a href={fam.exampleModel.url} class="family-model-link">
                    <span>{fam.exampleModel.label}</span>
                    <span class="link-arrow" aria-hidden="true">→</span>
                  </a>
                  <p class="family-model-note">
                    {fam.exampleModel.note}
                  </p>
                </div>
              ) : (
                <div class="family-future-box">
                  <span class="future-icon" aria-hidden="true">📋</span>
                  <p class="future-text">{fam.futureNote}</p>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. СЕКЦІЯ «СТАНДАРТИ ТА ІНТЕРФЕЙСИ»
       ========================================================================= -->
  <section class="section section-standards" aria-labelledby="standards-heading">
    <div class="container">
      <div class="section-header">
        <div class="section-tag" aria-hidden="true">МЕХАНІЧНІ ІНТЕРФЕЙСИ МОНТАЖУ</div>
        <h2 id="standards-heading" class="section-heading">
          Стандарти та інтерфейси
        </h2>
        <p class="section-lead">
          Механічні інтерфейси забезпечують жорстке, повторюване та безпечне кріплення оптики,
          лазерних блоків, освітлювачів і руківʼїв. Ознайомтеся з характеристиками найбільш поширених систем.
        </p>
      </div>

      <div class="standards-grid">
        {
          MECHANICAL_STANDARDS.map((std) => (
            <article class="standard-card">
              <div class="standard-top">
                <span class="standard-tag">{std.tag}</span>
              </div>
              <h3 class="standard-title">{std.title}</h3>
              <p class="standard-summary">{std.summary}</p>

              <div class="standard-spec-block">
                <span class="spec-block-label">ТЕХНІЧНІ ПАРАМЕТРИ ТА ІСТОРІЯ:</span>
                <p class="standard-tech">{std.technicalDetails}</p>
              </div>

              <div class="standard-app-block">
                <span class="spec-block-label">ОБЛАСТЬ ЗАСТОСУВАННЯ:</span>
                <p class="standard-app">{std.application}</p>
              </div>

              {std.cautionNote && (
                <div class="standard-caution" role="note">
                  <span class="caution-icon" aria-hidden="true">ℹ</span>
                  <p class="caution-text">{std.cautionNote}</p>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================================================================
       5. СЕКЦІЯ «ЯК РОЗУМІТИ СУМІСНІСТЬ ОБЛАДНАННЯ» (Editorial Advisory)
       ========================================================================= -->
  <section class="section section-advisory" aria-labelledby="advisory-heading">
    <div class="container">
      <div class="advisory-panel">
        <div class="advisory-header">
          <div class="section-tag" aria-hidden="true">РЕДАКЦІЙНЕ ЗАСТЕРЕЖЕННЯ</div>
          <h2 id="advisory-heading" class="advisory-title">
            Як правильно розуміти сумісність обладнання
          </h2>
          <p class="advisory-lead">
            Сумісність деталей чи обвісу — це не просто формальний збіг назви інтерфейсу в каталозі.
            Щоб уникнути пошкодження обладнання або нештатних затримок під час стрільби, враховуйте
            фундаментальні інженерні аспекти:
          </p>
        </div>

        <div class="advisory-grid">
          <div class="advisory-item">
            <div class="item-num" aria-hidden="true">1</div>
            <div class="item-content">
              <h3 class="item-title">Збіг назви не гарантує сумісності</h3>
              <p class="item-desc">
                Навіть якщо цівка й ліхтар заявлені як сумісні з M-LOK чи Picatinny, геометрія ствола під цівкою,
                довжина монтажних гвинтів або ширина посадкового майданчика можуть завадити коректній установці.
              </p>
            </div>
          </div>

          <div class="advisory-item">
            <div class="item-num" aria-hidden="true">2</div>
            <div class="item-content">
              <h3 class="item-title">Покоління мають критичні відмінності</h3>
              <p class="item-desc">
                Моделі різних поколінь (як-от Glock Gen3 проти Gen5) часто використовують різні посадки затвора,
                важелі затримки та геометрію рамки, що унеможливлює сліпе перенесення компонентів.
              </p>
            </div>
          </div>

          <div class="advisory-item">
            <div class="item-num" aria-hidden="true">3</div>
            <div class="item-content">
              <h3 class="item-title">Специфічні заводські обмеження</h3>
              <p class="item-desc">
                Виробники встановлюють точні моменти затягування різьбових зʼєднань (torque rating) та граничну
                довжину гвинтів — занадто довгий гвинт коліматора на пістолетному затворі може заблокувати екстрактор.
              </p>
            </div>
          </div>

          <div class="advisory-item">
            <div class="item-num" aria-hidden="true">4</div>
            <div class="item-content">
              <h3 class="item-title">Зовнішня схожість не дорівнює відповідності</h3>
              <p class="item-desc">
                Деталі сторонніх брендів можуть візуально повторювати оригінальні елементи, але мати інші технологічні
                допуски (tolerances), що спричиняє люфти, підвищене зношування або порушення безпеки зброї.
              </p>
            </div>
          </div>

          <div class="advisory-item">
            <div class="item-num" aria-hidden="true">5</div>
            <div class="item-content">
              <h3 class="item-title">Верифікація за офіційною документацією</h3>
              <p class="item-desc">
                Будь-які технічні параметри, розміри гвинтів та вимоги до монтажних пластин необхідно перевіряти
                виключно за офіційними керівництвами з експлуатації (User Manuals) конкретних виробів.
              </p>
            </div>
          </div>
        </div>

        <div class="advisory-footer-note">
          <p>
            <strong>Інформаційне застереження:</strong> Firearms Explorer надає виключно довідкову
            та освітню інформацію. Портал не публікує інструкцій із самостійного складання зброї, кустарної
            модифікації механізмів чи обходу технічних вимог безпеки.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       6. СЕКЦІЯ «ДЖЕРЕЛА ТА ТЕХНІЧНА ДОКУМЕНТАЦІЯ»
       ========================================================================= -->
  <section class="section section-sources" aria-labelledby="sources-heading">
    <div class="container">
      <div class="section-header">
        <div class="section-tag" aria-hidden="true">ТЕХНІЧНА ВЕРИФІКАЦІЯ</div>
        <h2 id="sources-heading" class="section-heading">
          Джерела та документація
        </h2>
        <p class="section-lead">
          Офіційні військові специфікації, відкриті галузеві стандарти та керівництва виробників,
          використані під час підготовки цього довідника:
        </p>
      </div>

      <div class="sources-grid">
        {
          TECHNICAL_SOURCES.map((src) => (
            <article class="source-card">
              <div class="source-top">
                <span class="source-org">{src.organization}</span>
                {src.year && <span class="source-year">{src.year}</span>}
              </div>
              <h3 class="source-title">
                <a
                  href={src.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="source-link"
                >
                  <span>{src.title}</span>
                  <span class="ext-icon" aria-hidden="true">↗</span>
                </a>
              </h3>
              <p class="source-desc">{src.description}</p>
              <div class="source-url-display" aria-hidden="true">
                {src.url}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     1. HERO СЕКЦІЯ (Dark Tactical Canvas)
     ========================================================================== */
  .platforms-hero {
    background-color: var(--color-dark-canvas);
    color: var(--color-dark-text);
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--color-dark-border);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.25fr 0.75fr;
      gap: clamp(2rem, 4vw, 3.5rem);
    }
  }

  .header-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.1em;
    color: var(--color-amber);
    margin-bottom: var(--space-sm);
  }

  .kicker-bar {
    width: 20px;
    height: 2px;
    background-color: var(--color-amber);
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.25rem);
    font-weight: var(--weight-bold);
    color: var(--color-dark-text);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .hero-lead {
    font-size: clamp(1.0625rem, 1.5vw + 0.5rem, 1.25rem);
    color: var(--color-dark-text-secondary);
    line-height: var(--leading-relaxed);
    margin-top: 0;
    margin-bottom: var(--space-lg);
    max-width: 720px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .hero-btn-primary {
    background-color: var(--color-accent);
    color: #ffffff;
    border: 1px solid var(--color-accent);
  }

  .hero-btn-primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .hero-btn-primary:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 3px;
  }

  .hero-btn-secondary {
    background-color: var(--color-dark-surface);
    color: var(--color-dark-text);
    border: 1px solid var(--color-dark-border);
  }

  .hero-btn-secondary:hover {
    background-color: var(--color-dark-surface-2);
    border-color: var(--color-accent-light);
  }

  .hero-btn-secondary:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 3px;
  }

  .btn-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  /* Бічна панель Hero */
  .hero-side-panel {
    background-color: var(--color-dark-surface);
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    box-shadow: var(--shadow-dark-md);
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-bottom: var(--space-sm);
    margin-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-dark-border);
  }

  .panel-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-dark-text-muted);
  }

  .panel-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
    background-color: var(--color-amber-muted);
    color: var(--color-amber);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .panel-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .panel-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
  }

  .panel-num {
    font-family: var(--font-mono);
