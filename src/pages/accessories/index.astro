---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  ACCESSORY_CATEGORIES,
  getAccessoryCategoryById,
} from '../../data/accessoryCategories';

// Отримання лише опублікованих записів аксесуарів (відокремлення чернеток)
const accessories = await getCollection(
  'accessories',
  ({ data }) => !data.draft
);

// Сортування за алфавітом за українською локаллю
const sortedAccessories = accessories.sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'uk')
);
const hasAccessories = sortedAccessories.length > 0;
---

<BaseLayout
  title="Аксесуари та оптика — Firearms Explorer"
  description="Досліджуй сучасну оптику, електронні модулі, кріплення, магазини та інше обладнання. Технології, виробники, характеристики й документація в одному каталозі."
>
  <!-- 1. HERO СЕКЦІЯ (Dark Tactical Canvas) -->
  <section class="accessories-hero" aria-labelledby="page-title">
    <div class="container">
      <div class="hero-inner">
        <div class="header-kicker" aria-hidden="true">
          <span class="kicker-bar"></span>
          <span>ACCESSORIES / OPTICS / EQUIPMENT</span>
        </div>

        <h1 id="page-title" class="hero-title">
          Аксесуари та оптика
        </h1>

        <p class="hero-lead">
          Досліджуй сучасну оптику, електронні модулі, кріплення, магазини та інше обладнання.
          Технології, виробники, характеристики й документація в одному каталозі.
        </p>

        <!-- Інженерна панель параметрів та статусу розділу -->
        <div class="spec-bar" aria-label="Параметри розділу">
          <div class="spec-item">
            <span class="spec-label">КЛАСИФІКАЦІЯ</span>
            <span class="spec-val">8 категорій систем</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-item">
            <span class="spec-label">СТАНДАРТИ МОНТАЖУ</span>
            <span class="spec-val">MIL-STD-1913 · M-LOK · Footprints</span>
          </div>
          <div class="spec-divider" aria-hidden="true"></div>
          <div class="spec-item">
            <span class="spec-label">СТАТУС КАТАЛОГУ</span>
            <span class="spec-val spec-val-status">
              {hasAccessories
                ? `Опубліковано ${sortedAccessories.length} позицій`
                : 'Формування бази знань'}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. СЕКЦІЯ КАТЕГОРІЙ ОБЛАДНАННЯ (Light Editorial Canvas) -->
  <section class="categories-section" aria-labelledby="categories-heading">
    <div class="container">
      <div class="section-intro">
        <div class="section-tag" aria-hidden="true">КЛАСИФІКАЦІЯ СИСТЕМ</div>
        <h2 id="categories-heading" class="section-title">
          Категорії обладнання
        </h2>
        <p class="section-desc">
          Систематизований перелік напрямів додаткового оснащення зброї — від коліматорних
          та високоточних оптичних систем до модульних інтерфейсів монтажу та сертифікованого захисного спорядження.
        </p>
      </div>

      <div class="categories-grid">
        {
          ACCESSORY_CATEGORIES.map((cat) => (
            <article class="category-card">
              <div class="category-card-top">
                <span class="category-pill">Клас</span>
                <span class="category-index">0{cat.order}</span>
              </div>
              <h3 class="category-title">{cat.name}</h3>
              <p class="category-description">{cat.description}</p>
              {cat.note && (
                <div class="category-note">
                  <span class="note-bullet" aria-hidden="true">↳</span>
                  <span>{cat.note}</span>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3. СЕКЦІЯ КАТАЛОГУ АКСЕСУАРІВ -->
  <section class="catalog-section" aria-labelledby="catalog-heading">
    <div class="container">
      <div class="section-intro">
        <div class="section-tag" aria-hidden="true">БАЗА ЗНАНЬ</div>
        <h2 id="catalog-heading" class="section-title">
          Каталог аксесуарів
        </h2>
        <p class="section-desc">
          Технічні паспорти серійних зразків оптики та аксесуарів із зазначенням брендів,
          конструктивних характеристик, інтерфейсів кріплення та перевірених першоджерел.
        </p>
      </div>

      {
        hasAccessories ? (
          <div class="accessories-grid">
            {sortedAccessories.map((item) => {
              const catObj = getAccessoryCategoryById(item.data.category);
              const catName = catObj ? catObj.name : item.data.category;
              return (
                <article class="accessory-card">
                  <div class="accessory-card-header">
                    <span class="badge-category">{catName}</span>
                    {item.data.countryOfOrigin && (
                      <span class="badge-country">{item.data.countryOfOrigin}</span>
                    )}
                  </div>
                  <div class="accessory-card-body">
                    <div class="accessory-brand">{item.data.brand}</div>
                    <h3 class="accessory-title">{item.data.title}</h3>
                    {item.data.model && (
                      <div class="accessory-model">{item.data.model}</div>
                    )}
                    <p class="accessory-summary">{item.data.summary}</p>
                  </div>
                  <div class="accessory-card-footer">
                    <span class="accessory-sources">
                      Джерела: {item.data.sources.length}
                    </span>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          /* Повноцінний Empty State для етапу підготовки каталогу */
          <div class="empty-state-card" role="status">
            <div class="empty-state-badge" aria-hidden="true">
              ЕТАП НАПОВНЕННЯ
            </div>
            <h3 class="empty-state-title">Каталог обладнання готується</h3>
            <p class="empty-state-text">
              Ми поступово додаємо перевірені матеріали про сучасну оптику, аксесуари та спорядження.
              Незабаром тут з'являться перші записи.
            </p>
            <div class="empty-state-meta" aria-hidden="true">
              <span class="meta-tag">Офіційні мануали</span>
              <span class="meta-sep">·</span>
              <span class="meta-tag">Стандарти кріплень</span>
              <span class="meta-sep">·</span>
              <span class="meta-tag">Оптичні footprints</span>
              <span class="meta-sep">·</span>
              <span class="meta-tag">Сертифікати захисту</span>
            </div>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ==========================================================================
     1. HERO СЕКЦІЯ (Dark Tactical Canvas)
     ========================================================================== */
  .accessories-hero {
    background-color: var(--color-dark-canvas);
    color: var(--color-dark-text);
    border-bottom: 1px solid var(--color-dark-border);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-inner {
    max-width: 900px;
  }

  .header-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.12em;
    color: var(--color-amber-light);
    margin-bottom: var(--space-sm);
  }

  .kicker-bar {
    display: inline-block;
    width: 1.5rem;
    height: 2px;
    background-color: var(--color-amber);
  }

  .hero-title {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.25rem);
    font-weight: var(--weight-bold);
    color: var(--color-dark-text);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-top: 0;
    margin-bottom: var(--space-sm);
  }

  .hero-lead {
    font-size: clamp(1.0625rem, 1.5vw + 0.5rem, 1.25rem);
    color: var(--color-dark-text-secondary);
    line-height: var(--leading-relaxed);
    margin-top: 0;
    margin-bottom: var(--space-lg);
    max-width: 780px;
  }

  /* Панель параметрів (Spec Bar) */
  .spec-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
    background-color: var(--color-dark-surface);
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spec-label {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-dark-text-muted);
  }

  .spec-val {
    font-weight: var(--weight-medium);
    color: var(--color-dark-text);
  }

  .spec-val-status {
    color: var(--color-amber-light);
    font-weight: var(--weight-semibold);
  }

  .spec-divider {
    width: 1px;
    height: 28px;
    background-color: var(--color-dark-border);
    display: none;
  }

  @media (min-width: 640px) {
    .spec-divider {
      display: block;
    }
  }

  /* ==========================================================================
     2. СЕКЦІЯ КАТЕГОРІЙ ОБЛАДНАННЯ (Light Editorial Canvas)
     ========================================================================== */
  .categories-section {
    background-color: var(--color-bg);
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-border);
  }

  .section-intro {
    max-width: 760px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-2xs);
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .section-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  /* Адаптивна сітка категорій: 1 колонка (мобільні) -> 2 (планшети) -> 4 (десктоп) */
  .categories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .categories-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .category-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2vw, 1.5rem);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .category-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }

  .category-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xs);
  }

  .category-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background-color: var(--color-accent-muted);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .category-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
  }

  .category-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: var(--space-2xs);
  }

  .category-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-top: 0;
    margin-bottom: var(--space-sm);
    flex-grow: 1;
  }

  .category-note {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border-subtle);
  }

  .note-bullet {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ==========================================================================
     3. СЕКЦІЯ КАТАЛОГУ АКСЕСУАРІВ
     ========================================================================== */
  .catalog-section {
    background-color: var(--color-bg);
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Сітка для майбутніх записів */
  .accessories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .accessories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .accessories-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .accessory-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 2vw, 1.5rem);
    box-shadow: var(--shadow-sm);
  }

  .accessory-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-xs);
  }

  .badge-category {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    background-color: var(--color-accent-muted);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .badge-country {
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    background-color: var(--color-surface-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
  }

  .accessory-card-body {
    flex-grow: 1;
  }

  .accessory-brand {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-amber);
    margin-bottom: 0.25rem;
  }

  .accessory-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: var(--space-2xs);
  }

  .accessory-model {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .accessory-summary {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .accessory-card-footer {
    margin-top: var(--space-md);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--color-border-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-accent);
    font-weight: var(--weight-semibold);
  }

  /* Порожній стан (Empty State) */
  .empty-state-card {
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 5vw, 3.5rem) clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    box-shadow: var(--shadow-sm);
  }

  .empty-state-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.12em;
    color: var(--color-amber);
    background-color: var(--color-amber-muted);
    border: 1px solid rgba(217, 107, 39, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-sm);
  }

  .empty-state-title {
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: var(--weight-bold);
    letter-spacing: -0.015em;
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: var(--space-xs);
  }

  .empty-state-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 560px;
    margin-inline: auto;
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .empty-state-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border-subtle);
  }

  .meta-tag {
    letter-spacing: 0.04em;
  }

  .meta-sep {
    color: var(--color-border-strong);
  }
</style>
