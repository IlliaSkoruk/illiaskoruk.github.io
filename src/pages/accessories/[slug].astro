---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAccessoryCategoryById } from '../../data/accessoryCategories';
import ContentImage from '../../components/ContentImage.astro';

export async function getStaticPaths() {
  const accessories = await getCollection('accessories', ({ data }) => !data.draft);
  return accessories.map((accessory) => ({
    params: { slug: accessory.id },
    props: { accessory },
  }));
}

const { accessory } = Astro.props;
const { data } = accessory;
const { Content } = await render(accessory);

const categoryObj = getAccessoryCategoryById(data.category);
const categoryLabel = categoryObj ? categoryObj.name : data.category;

const formattedReviewedDate = data.lastReviewedAt.toLocaleDateString('uk-UA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${data.title} — Firearms Explorer`}
  description={data.summary}
>
  <!-- 1. HERO СЕКЦІЯ (Dark Tactical Canvas) -->
  <section class="detail-hero" aria-labelledby="accessory-title">
    <div class="container">
      <div class="hero-top-bar">
        <nav class="breadcrumbs" aria-label="Навігаційний шлях">
          <ol class="breadcrumb-list">
            <li class="breadcrumb-item">
              <a href="/" class="breadcrumb-link">Головна</a>
            </li>
            <li class="breadcrumb-sep" aria-hidden="true">/</li>
            <li class="breadcrumb-item">
              <a href="/accessories/" class="breadcrumb-link">Аксесуари та оптика</a>
            </li>
            <li class="breadcrumb-sep" aria-hidden="true">/</li>
            <li class="breadcrumb-item breadcrumb-current" aria-current="page">
              {data.title}
            </li>
          </ol>
        </nav>

        <a href="/accessories/" class="back-link">
          <span aria-hidden="true" class="back-arrow">←</span> Назад до аксесуарів
        </a>
      </div>

      <div class="hero-main">
        <div class="hero-meta-strip">
          <span class="badge-category">{categoryLabel}</span>
          {data.brand && (
            <span class="badge-brand">{data.brand}</span>
          )}
          {data.countryOfOrigin && (
            <span class="badge-country">{data.countryOfOrigin}</span>
          )}
          {data.introducedYear && (
            <span class="badge-year">{data.introducedYear} р.</span>
          )}
          <span class="badge-id" aria-hidden="true">ID: {accessory.id}</span>
        </div>

        <h1 id="accessory-title" class="hero-title">{data.title}</h1>

        {data.model && data.model !== data.title && (
          <div class="hero-model-name">
            <span class="name-label">Модель / серія:</span>
            <span class="name-val">{data.model}</span>
          </div>
        )}

        <p class="hero-summary">{data.summary}</p>
      </div>
    </div>
  </section>

  <!-- 2. ОСНОВНИЙ РЕДАКЦІЙНИЙ КОНТЕНТ (Light Editorial Canvas) -->
  <div class="content-wrapper">
    <div class="container container-content">
      <!-- Основна фотографія з атрибуцією -->
      {data.image && (
        <ContentImage
          image={data.image}
          title={data.title}
          categoryLabel={categoryLabel}
          mode="detail"
          loading="eager"
        />
      )}

      <!-- Інформаційний паспорт аксесуара -->
      <section class="passport-section" aria-labelledby="passport-title">
        <div class="passport-card">
          <div class="passport-header">
            <span class="passport-kicker" aria-hidden="true">ТЕХНІЧНИЙ ПАСПОРТ</span>
            <h2 id="passport-title" class="passport-title">Основна інформація</h2>
          </div>

          <dl class="passport-grid">
            <div class="passport-row">
              <dt class="passport-term">Назва</dt>
              <dd class="passport-def">{data.title}</dd>
            </div>
            <div class="passport-row">
              <dt class="passport-term">Бренд</dt>
              <dd class="passport-def">{data.brand}</dd>
            </div>
            <div class="passport-row">
              <dt class="passport-term">Категорія</dt>
              <dd class="passport-def">{categoryLabel}</dd>
            </div>
            {data.model && (
              <div class="passport-row">
                <dt class="passport-term">Модель або серія</dt>
                <dd class="passport-def">{data.model}</dd>
              </div>
            )}
            {data.countryOfOrigin && (
              <div class="passport-row">
                <dt class="passport-term">Країна походження</dt>
                <dd class="passport-def">{data.countryOfOrigin}</dd>
              </div>
            )}
            {data.introducedYear && (
              <div class="passport-row">
                <dt class="passport-term">Рік появи</dt>
                <dd class="passport-def">{data.introducedYear} рік</dd>
              </div>
            )}
          </dl>
        </div>
      </section>

      <!-- Тіло статті з Markdown -->
      <article class="article-body" aria-label="Детальний опис та характеристики">
        <Content />
      </article>

      <!-- Блок джерел інформації -->
      <section class="sources-section" aria-labelledby="sources-heading">
        <div class="sources-card">
          <div class="sources-header">
            <div class="sources-kicker" aria-hidden="true">ДЖЕРЕЛА</div>
            <h2 id="sources-heading" class="sources-title">Джерела та редакційна перевірка</h2>
            <p class="sources-desc">
              Технічні параметри та функціональні особливості виробу зафіксовано на основі офіційної
              документації виробника, технічних специфікацій та відкритих профільних джерел.
            </p>
          </div>

          <ol class="sources-list">
            {data.sources.map((source, index) => (
              <li class="source-item">
                <span class="source-index" aria-hidden="true">[{index + 1}]</span>
                <div class="source-content">
                  <div class="source-heading">
                    {source.url ? (
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="source-title-link"
                      >
                        {source.title}
                        <span class="ext-icon" aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <span class="source-title">{source.title}</span>
                    )}
                  </div>
                  <div class="source-meta">
                    {source.author && (
                      <span class="source-author">{source.author}</span>
                    )}
                    {source.author && source.year && (
                      <span class="source-dot" aria-hidden="true">·</span>
                    )}
                    {source.year && (
                      <span class="source-year">{source.year} р.</span>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>

          <div class="editorial-footer">
            <span class="editorial-check-badge" aria-hidden="true">✓</span>
            <span class="editorial-date">
              Остання редакційна перевірка: <strong>{formattedReviewedDate}</strong>
            </span>
          </div>
        </div>
      </section>

      <!-- Нижня навігація повернення до каталогу аксесуарів -->
      <div class="detail-bottom-nav">
        <a href="/accessories/" class="btn-back-catalog">
          <span aria-hidden="true" class="back-arrow">←</span> Назад до аксесуарів
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     1. HERO СЕКЦІЯ (Dark Tactical Canvas)
     ========================================================================== */
  .detail-hero {
    background-color: var(--color-dark-canvas);
    color: var(--color-dark-text);
    border-bottom: 1px solid var(--color-dark-border);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .hero-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    padding-bottom: 0.875rem;
    border-bottom: 1px solid var(--color-dark-border-subtle);
  }

  /* Breadcrumbs */
  .breadcrumbs {
    font-size: var(--text-xs);
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-item {
    margin: 0;
    line-height: 1.4;
  }

  .breadcrumb-item::marker {
    display: none;
  }

  .breadcrumb-link {
    color: var(--color-dark-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-link:hover {
    color: var(--color-dark-text);
  }

  .breadcrumb-link:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .breadcrumb-sep {
    color: var(--color-dark-border);
    font-size: 0.75rem;
    user-select: none;
  }

  .breadcrumb-current {
    color: var(--color-amber-light);
    font-weight: var(--weight-medium);
  }

  /* Back Link */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
    color: var(--color-dark-text-secondary);
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    background-color: var(--color-dark-surface);
    border: 1px solid var(--color-dark-border);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .back-link:hover {
    color: var(--color-dark-text);
    border-color: var(--color-accent-light);
    background-color: var(--color-dark-surface-2);
  }

  .back-link:focus-visible {
    outline: 2px solid var(--color-focus-dark);
    outline-offset: 2px;
  }

  .back-arrow {
    transition: transform 0.15s ease;
  }

  .back-link:hover .back-arrow {
    transform: translateX(-2px);
  }

  /* Meta Strip */
  .hero-meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: clamp(0.875rem, 2vw, 1.25rem);
  }

  .badge-category {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: #ffffff;
    background-color: var(--color-accent);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.03em;
  }

  .badge-brand {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-amber-light);
    background-color: rgba(217, 107, 39, 0.12);
    border: 1px solid rgba(217, 107, 39, 0.3);
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-sm);
  }

  .badge-country,
  .badge-year {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-dark-text-secondary);
    background-color: var(--color-dark-surface);
    border: 1px solid var(--color-dark-border);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .badge-id {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-dark-text-muted);
    letter-spacing: 0.04em;
    margin-left: auto;
  }

  /* Title & Lead */
  .hero-title {
    font-size: clamp(2rem, 4vw + 0.5rem, 3.25rem);
    font-weight: var(--weight-bold);
    color: var(--color-dark-text);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-top: 0;
    margin-bottom: 0.35rem;
  }

  .hero-model-name {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-dark-text-secondary);
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .name-label {
    color: var(--color-dark-text-muted);
    font-size: var(--text-xs);
  }

  .name-val {
    color: var(--color-dark-text);
  }

  .hero-summary {
    font-size: clamp(1.0625rem, 1.5vw + 0.5rem, 1.25rem);
    color: var(--color-dark-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 820px;
    margin: 0;
  }

  /* ==========================================================================
     2. РЕДАКЦІЙНИЙ КОНТЕНТ (Light Editorial Canvas)
     ========================================================================== */
  .content-wrapper {
    background-color: var(--color-bg);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .container-content {
    max-width: 820px;
  }

  /* Passport Section */
  .passport-section {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .passport-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .passport-header {
    background-color: var(--color-surface-subtle);
    padding: 1.25rem clamp(1.25rem, 3vw, 1.75rem);
    border-bottom: 1px solid var(--color-border);
  }

  .passport-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .passport-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin: 0;
  }

  .passport-grid {
    display: grid;
    grid-template-columns: 1fr;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 640px) {
    .passport-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .passport-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem clamp(1.25rem, 3vw, 1.75rem);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 640px) {
    .passport-row:nth-child(odd) {
      border-right: 1px solid var(--color-border-subtle);
    }
    .passport-row:nth-last-child(1),
    .passport-row:nth-last-child(2) {
      border-bottom: none;
    }
  }

  .passport-term {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .passport-def {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    margin: 0;
  }

  /* ==========================================================================
     3. ТИПОГРАФІКА СТАТТІ (Markdown Content)
     ========================================================================== */
  .article-body {
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.0625rem);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    margin-bottom: clamp(3rem, 5vw, 4rem);
  }

  .article-body :global(h2) {
    font-size: clamp(1.375rem, 2vw + 0.5rem, 1.75rem);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-top: clamp(2.25rem, 4vw, 3rem);
    margin-bottom: var(--space-sm);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }

  .article-body :global(h2)::before {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 2.5rem;
    height: 2px;
    background-color: var(--color-accent);
  }

  .article-body :global(p) {
    margin-top: 0;
    margin-bottom: var(--space-md);
    color: var(--color-text);
  }

  .article-body :global(ol),
  .article-body :global(ul) {
    margin-top: 0;
    margin-bottom: var(--space-lg);
    padding-left: 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
    line-height: var(--leading-normal);
  }

  .article-body :global(li strong) {
    color: var(--color-text);
  }

  .article-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .article-body :global(a:hover) {
    color: var(--color-accent-hover);
  }

  /* ==========================================================================
     4. СЕКЦІЯ ДЖЕРЕЛ ІНФОРМАЦІЇ
     ========================================================================== */
  .sources-section {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .sources-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    box-shadow: var(--shadow-sm);
  }

  .sources-kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: 0.25rem;
  }

  .sources-title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-top: 0;
    margin-bottom: 0.5rem;
  }

  .sources-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .sources-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: var(--space-md);
  }

  .source-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem;
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    margin: 0;
  }

  .source-item::marker {
    display: none;
  }

  .source-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    flex-shrink: 0;
    padding-top: 0.1rem;
  }

  .source-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex-grow: 1;
  }

  .source-heading {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .source-title-link {
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .source-title-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .source-title-link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .ext-icon {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--color-accent);
    margin-left: 0.25rem;
  }

  .source-title {
    color: var(--color-text);
  }

  .source-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .source-dot {
    color: var(--color-border-strong);
  }

  .editorial-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
  }

  .editorial-check-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
    background-color: var(--color-accent-muted);
    color: var(--color-accent);
    border-radius: 50%;
    font-weight: var(--weight-bold);
    font-size: 0.6875rem;
  }

  .editorial-date strong {
    color: var(--color-text);
  }

  /* ==========================================================================
     5. НИЖНЯ НАВІГАЦІЯ
     ========================================================================== */
  .detail-bottom-nav {
    display: flex;
    justify-content: center;
    padding-top: var(--space-md);
  }

  .btn-back-catalog {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-accent-text);
    background-color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }

  .btn-back-catalog:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    box-shadow: var(--shadow-md);
  }

  .btn-back-catalog:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .btn-back-catalog:hover .back-arrow {
    transform: translateX(-3px);
  }
</style>
