---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Безпека та право — Firearms Explorer"
  description="Принципи відповідального поводження та правові орієнтири."
>
  <div class="container section">
    <div class="container-narrow">
      <h1>Безпека та право</h1>
      <p class="text-secondary" style="font-size: var(--text-lg);">
        Культура безпечного поводження, фундаментальні засади безпеки та методологія правових відомостей із посиланнями на офіційні першоджерела.
      </p>

      <div class="surface-subtle" style="margin-top: var(--space-xl); display: inline-block;">
        <p style="margin: 0; color: var(--color-accent); font-weight: var(--weight-medium);">
          Розділ у розробці
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
