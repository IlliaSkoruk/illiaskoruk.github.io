---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Технології — Firearms Explorer"
  description="Загальні інженерні та механічні концепції конструкцій вогнепальної зброї."
>
  <div class="container section">
    <div class="container-narrow">
      <h1>Технології</h1>
      <p class="text-secondary" style="font-size: var(--text-lg);">
        Пояснення механічних концепцій, автоматики, конструктивних рішень та класифікаційних систем.
      </p>

      <div class="surface-subtle" style="margin-top: var(--space-xl); display: inline-block;">
        <p style="margin: 0; color: var(--color-accent); font-weight: var(--weight-medium);">
          Розділ у розробці
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
