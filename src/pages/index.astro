---
import BaseLayout from '../layouts/BaseLayout.astro';

/* ===================================================================
   Дані для секцій — визначаємо тут для чистоти шаблону
   =================================================================== */

const sections = [
  {
    num: '01',
    title: 'Зброя',
    tag: 'Каталог моделей',
    href: '/encyclopedia/',
    desc: 'Сучасні стрілецькі системи: пістолети, карабіни, гвинтівки, дробовики, ПП та кулемети. Технічні характеристики, покоління та виробники.',
    cta: 'До каталогу',
  },
  {
    num: '02',
    title: 'Аксесуари та оптика',
    tag: 'Прицільні комплекси',
    href: '/accessories/',
    desc: 'Коліматори, LPVO, голографічні приціли, тактичні ліхтарі, лазерні модулі, глушники, цівки, магазини та інше спорядження.',
    cta: 'До аксесуарів',
  },
  {
    num: '03',
    title: 'Платформи та сумісність',
    tag: 'Стандарти інтерфейсів',
    href: '/platforms/',
    desc: 'AR-15, Glock, AK, SIG MCX та інші платформи. Стандарти монтажних інтерфейсів: Picatinny, M-LOK, KeyMod, Optic Footprints.',
    cta: 'До платформ',
  },
  {
    num: '04',
    title: 'Армії та конфлікти',
    tag: 'Документальний аналіз',
    href: '/military/',
    desc: 'Озброєння підрозділів ЗСУ, армії США, ЦАХАЛ та країн НАТО. Документально підтверджені дані з відкритих джерел.',
    cta: 'До розділу',
  },
  {
    num: '05',
    title: 'Тир і безпека',
    tag: 'Культура поводження',
    href: '/safety/',
    desc: 'Правила безпечного поводження зі зброєю, вибір захисного спорядження, підготовка до тиру та правова методологія.',
    cta: 'До розділу',
  },
];

const platforms = [
  {
    code: 'AR-15 / M4',
    name: 'Сімейство AR-15',
    desc: 'Модульна гвинтівкова платформа. Mil-Spec та комерційні варіанти. Широко використовується арміями США, НАТО та ЗСУ.',
  },
  {
    code: 'GLOCK',
    name: 'Glock Gen 3–5',
    desc: 'Серія пістолетів австрійського виробника. Покоління Gen3, Gen4, Gen5. Ударниковий механізм, полімерна рамка.',
  },
  {
    code: 'HK416',
    name: 'HK416 / HK417',
    desc: 'Штурмова гвинтівка Heckler & Koch із газовим приводом. Штатна зброя армій Норвегії, Франції, SOCOM США.',
  },
  {
    code: 'SIG SAUER',
    name: 'SIG MCX / Spear',
    desc: 'Платформа SIG MCX та NGSW Spear (XM7). Переможець конкурсу армії США на заміну M4. Калібр 6.8×51mm.',
  },
];

const gearCategories = [
  { icon: '◎', label: 'Оптика', sub: 'Коліматори, LPVO, голографи' },
  { icon: '◈', label: 'Ліхтарі та ЛЦУ', sub: 'Тактичні ліхтарі, AN/PEQ, DBAL' },
  { icon: '▣', label: 'Дульні пристрої', sub: 'Глушники, ДГК, полум\'ягасники' },
  { icon: '≡', label: 'Магазини', sub: 'STANAG, PMAG, Lancer, барабанні' },
  { icon: '⊞', label: 'Інтерфейси', sub: 'Picatinny, M-LOK, Optic Footprints' },
  { icon: '□', label: 'Фурнітура', sub: 'Цівки, приклади, руків\'я, ремені' },
];

const militaryUnits = [
  {
    country: 'Україна',
    abbr: 'UA',
    desc: 'ЗСУ, ССО, Нацгвардія — штатне та отримане партнерами озброєння.',
  },
  {
    country: 'США',
    abbr: 'US',
    desc: 'Army, USMC, SOCOM — від M4A1 до системи NGSW / SIG XM7.',
  },
  {
    country: 'Ізраїль',
    abbr: 'IL',
    desc: 'ЦАХАЛ — TAR-21 Tavor, Negev, Jericho та імпортовані системи.',
  },
  {
    country: 'НАТО',
    abbr: 'NATO',
    desc: 'Армії Польщі, Великобританії, Канади та інших країн-учасниць.',
  },
];

const principles = [
  {
    num: '01',
    title: 'Верифіковані характеристики',
    desc: 'Технічні дані підтверджені документацією виробників, патентами та перевіреними профільними виданнями.',
  },
  {
    num: '02',
    title: 'Зрозуміла класифікація',
    desc: 'Чітка структура: платформи, покоління, стандарти кріплень та технічна термінологія без зайвого жаргону.',
  },
  {
    num: '03',
    title: 'Відповідальний підхід',
    desc: 'Прозорі джерела, OSINT-методологія. Без небезпечних інструкцій, без комерційних рекомендацій.',
  },
];
---

<BaseLayout
  title="Firearms Explorer — Сучасна зброя, технології та оснащення армій"
  description="Сучасний інформаційний портал про стрілецьку зброю, оптику, аксесуари, збройові платформи та оснащення армій. AR-15, Glock, HK416, SIG Sauer — технічні характеристики й перевірені факти."
>

  <!-- ================================================================
       1. HERO — Dark Tactical Canvas
       ================================================================ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-inner">

      <!-- Ліва колонка: текст + CTA -->
      <div class="hero-text">
        <div class="hero-kicker" aria-hidden="true">
          <span class="kicker-bar"></span>
          <span class="kicker-label">FIREARMS EXPLORER&nbsp;/&nbsp;MODERN TECH</span>
        </div>

        <h1 id="hero-title" class="hero-title">
          Сучасна зброя.<br>Технології.<br class="br-mobile"> Деталі.
        </h1>

        <p class="hero-desc">
          Досліджуй сучасні стрілецькі платформи, оптику, аксесуари та оснащення армій.
          Технічні характеристики, перевірені факти й технології в одному
          інформаційному просторі.
        </p>

        <div class="hero-actions">
          <a href="/encyclopedia/" class="btn btn-amber">
            Дослідити зброю
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/accessories/" class="btn btn-outline-light">
            Аксесуари та оптика
          </a>
        </div>
      </div>

      <!-- Права колонка: декоративна тактична панель -->
      <div class="hero-visual" aria-hidden="true">
        <div class="tac-panel">
          <div class="tac-panel-header">
            <span class="tac-dot"></span>
            <span class="tac-dot tac-dot-amber"></span>
            <span class="tac-title">PLATFORM DATABASE</span>
          </div>
          <div class="tac-rows">
            <div class="tac-row">
              <span class="tac-code">AR-15</span>
              <span class="tac-badge">5.56×45 NATO</span>
            </div>
            <div class="tac-row">
              <span class="tac-code">GLOCK&nbsp;19</span>
              <span class="tac-badge">9×19mm</span>
            </div>
            <div class="tac-row">
              <span class="tac-code">HK416</span>
              <span class="tac-badge">5.56×45 NATO</span>
            </div>
            <div class="tac-row">
              <span class="tac-code">SIG&nbsp;MCX</span>
              <span class="tac-badge">300 BLK / .223</span>
            </div>
            <div class="tac-row">
              <span class="tac-code">FN&nbsp;SCAR-L</span>
              <span class="tac-badge">5.56×45 NATO</span>
            </div>
          </div>
          <div class="tac-tags">
            <span class="tac-tag">OPTICS</span>
            <span class="tac-tag">PLATFORMS</span>
            <span class="tac-tag">M-LOK</span>
            <span class="tac-tag">PICATINNY</span>
          </div>
          <div class="tac-footer-line">
            <span class="tac-mono">FIREARMS&nbsp;EXPLORER&nbsp;·&nbsp;v3.0</span>
          </div>
        </div>
      </div>

    </div>
  </section>


  <!-- ================================================================
       2. СЕКЦІЯ «ДОСЛІДЖУЙ ГОЛОВНЕ» — 5 карток розділів
       ================================================================ -->
  <section class="sections-section" aria-labelledby="sections-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="sections-heading" class="section-title">Досліджуй головне</h2>
        <p class="section-lead">
          Від сучасних стрілецьких платформ до оптики, обладнання та військових технологій.
        </p>
      </div>

      <div class="sections-grid">
        {sections.map((s) => (
          <article class="sec-card">
            <div class="sec-card-top">
              <span class="sec-tag">{s.tag}</span>
              <span class="sec-num">{s.num}</span>
            </div>
            <h3 class="sec-card-title">
              <a href={s.href} class="sec-card-link">{s.title}</a>
            </h3>
            <p class="sec-card-desc">{s.desc}</p>
            <div class="sec-card-footer">
              <a href={s.href} class="sec-card-cta">
                <span>{s.cta}</span>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ================================================================
       3. СУЧАСНІ ПЛАТФОРМИ — темна секція
       ================================================================ -->
  <section class="platforms-section" aria-labelledby="platforms-heading">
    <div class="container">
      <div class="platforms-header">
        <div class="section-kicker-light">
          <span class="kicker-bar-amber"></span>
          <span>МАЙБУТНІ МАТЕРІАЛИ</span>
        </div>
        <h2 id="platforms-heading" class="section-title-light">
          Сучасні платформи
        </h2>
        <p class="section-lead-light">
          Детальний аналіз провідних збройових платформ, їхніх модифікацій,
          поколінь та задокументованих характеристик.
        </p>
      </div>

      <div class="platforms-grid">
        {platforms.map((p) => (
          <div class="platform-card">
            <div class="platform-code">{p.code}</div>
            <h3 class="platform-name">{p.name}</h3>
            <p class="platform-desc">{p.desc}</p>
          </div>
        ))}
      </div>

      <div class="platforms-cta">
        <a href="/encyclopedia/" class="btn btn-amber">
          Перейти до каталогу зброї
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>


  <!-- ================================================================
       4. ОПТИКА ТА ОБЛАДНАННЯ — світла секція
       ================================================================ -->
  <section class="gear-section" aria-labelledby="gear-heading">
    <div class="container">
      <div class="gear-header">
        <h2 id="gear-heading" class="section-title">
          Не лише зброя.<br>Ціла екосистема технологій.
        </h2>
        <p class="section-lead-narrow">
          Firearms Explorer охоплює повний спектр сучасного тактичного спорядження:
          від прицільних комплексів до стандартів монтажних інтерфейсів.
        </p>
      </div>

      <div class="gear-grid">
        {gearCategories.map((g) => (
          <div class="gear-card">
            <span class="gear-icon" aria-hidden="true">{g.icon}</span>
            <div>
              <div class="gear-label">{g.label}</div>
              <div class="gear-sub">{g.sub}</div>
            </div>
          </div>
        ))}
      </div>

      <div class="gear-cta">
        <a href="/accessories/" class="btn btn-primary">
          Переглянути розділ аксесуарів
        </a>
      </div>
    </div>
  </section>


  <!-- ================================================================
       5. АРМІЇ ТА ОСНАЩЕННЯ — темна секція
       ================================================================ -->
  <section class="military-section" aria-labelledby="military-heading">
    <div class="container">
      <div class="military-header">
        <div class="section-kicker-light">
          <span class="kicker-bar-amber"></span>
          <span>ВІДКРИТІ ДЖЕРЕЛА · OSINT</span>
        </div>
        <h2 id="military-heading" class="section-title-light">
          Сучасні армії та оснащення
        </h2>
        <p class="section-lead-light">
          Документально підтверджені дані про штатне озброєння провідних армій світу.
          Виключно на основі публічних матеріалів, офіційних звітів та відкритих джерел.
        </p>
      </div>

      <div class="military-grid">
        {militaryUnits.map((m) => (
          <div class="mil-card">
            <div class="mil-abbr">{m.abbr}</div>
            <div class="mil-country">{m.country}</div>
            <p class="mil-desc">{m.desc}</p>
          </div>
        ))}
      </div>

      <div class="military-cta">
        <a href="/military/" class="btn btn-outline-light">
          Армії та конфлікти →
        </a>
      </div>
    </div>
  </section>


  <!-- ================================================================
       6. РЕДАКЦІЙНІ ПРИНЦИПИ — світла секція
       ================================================================ -->
  <section class="principles-section" aria-labelledby="principles-heading">
    <div class="container">
      <div class="principles-header">
        <h2 id="principles-heading" class="section-title">
          Факти. Джерела. Технології.
        </h2>
        <p class="section-lead-narrow">
          Три редакційні принципи, на яких будується Firearms Explorer.
        </p>
      </div>

      <div class="principles-grid">
        {principles.map((p) => (
          <div class="principle-card">
            <div class="principle-num">{p.num}</div>
            <h3 class="principle-title">{p.title}</h3>
            <p class="principle-desc">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ================================================================
       7. CTA — темний завершальний блок
       ================================================================ -->
  <section class="cta-section" aria-labelledby="cta-heading">
    <div class="container cta-inner">
      <h2 id="cta-heading" class="cta-title">
        Досліджуй технології<br>сучасної зброї
      </h2>
      <p class="cta-desc">
        Firearms Explorer поступово наповнюється верифікованими матеріалами.
        Починай дослідження з каталогу зброї або обери розділ, який тебе цікавить.
      </p>
      <div class="cta-actions">
        <a href="/encyclopedia/" class="btn btn-amber">
          Перейти до каталогу
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/platforms/" class="btn btn-outline-light">Платформи та сумісність</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ====================================================================
   ГЛОБАЛЬНІ ХЕЛПЕРИ ДЛЯ ЦІЄї СТОРІНКИ
   ==================================================================== */

.section-kicker-light {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.08em;
  color: var(--color-dark-text-secondary);
  margin-bottom: var(--space-xs);
}

.kicker-bar {
  display: inline-block;
  width: 22px;
  height: 2px;
  background-color: var(--color-amber);
  flex-shrink: 0;
}

.kicker-bar-amber {
  display: inline-block;
  width: 20px;
  height: 2px;
  background-color: var(--color-amber);
  flex-shrink: 0;
}

/* Кнопка Amber — CTA на темних секціях */
.btn-amber {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 44px;
  padding: 0.625rem 1.375rem;
  background-color: var(--color-amber);
  color: var(--color-amber-text);
  border: 1px solid var(--color-amber);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  text-decoration: none;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.btn-amber:hover {
  background-color: var(--color-amber-hover);
  border-color: var(--color-amber-hover);
  color: var(--color-amber-text);
  text-decoration: none;
}

.btn-amber:focus-visible {
  outline: 2px solid var(--color-focus-dark);
  outline-offset: 3px;
}

/* Контурна кнопка на темних секціях */
.btn-outline-light {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 44px;
  padding: 0.625rem 1.375rem;
  background-color: transparent;
  color: var(--color-dark-text);
  border: 1px solid var(--color-dark-border);
  border-radius: var(--radius-sm);
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  text-decoration: none;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
}

.btn-outline-light:hover {
  background-color: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.25);
  color: var(--color-dark-text);
  text-decoration: none;
}

.btn-outline-light:focus-visible {
  outline: 2px solid var(--color-focus-dark);
  outline-offset: 3px;
}

/* ====================================================================
   HERO
   ==================================================================== */
.hero {
  background-color: var(--color-dark-canvas);
  padding-top: clamp(3rem, 7vw, 5.5rem);
  padding-bottom: clamp(3rem, 7vw, 5rem);
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(2.5rem, 5vw, 4rem);
}

@media (min-width: 900px) {
  .hero-inner {
    grid-template-columns: 1fr 380px;
    align-items: center;
  }
}

@media (min-width: 1100px) {
  .hero-inner {
    grid-template-columns: 1fr 440px;
  }
}

/* Кікер */
.hero-kicker {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  letter-spacing: 0.1em;
  color: var(--color-dark-text-secondary);
  margin-bottom: var(--space-sm);
}

.kicker-label {
  /* вже inline в flex */
}

/* Заголовок Hero */
.hero-title {
  font-size: clamp(2.25rem, 5.5vw, 4rem);
  font-weight: var(--weight-bold);
  letter-spacing: -0.035em;
  line-height: 1.08;
  color: var(--color-dark-text);
  margin-top: 0;
  margin-bottom: var(--space-md);
}

.br-mobile {
  display: none;
}

@media (max-width: 480px) {
  .br-mobile {
    display: inline;
  }
}

/* Опис */
.hero-desc {
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  line-height: var(--leading-relaxed);
  color: var(--color-dark-text-secondary);
  max-width: 520px;
  margin-bottom: var(--space-lg);
}

/* Кнопки */
.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

/* -------- Декоративна тактична панель -------- */
.hero-visual {
  display: none;
}

@media (min-width: 900px) {
  .hero-visual {
    display: block;
  }
}

.tac-panel {
  background-color: var(--color-dark-surface);
  border: 1px solid var(--color-dark-border);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  font-family: var(--font-mono);
}

.tac-panel-header {
  display: flex;
