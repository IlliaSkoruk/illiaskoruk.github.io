---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Словник — Firearms Explorer"
  description="Довідник термінів, абревіатур та спеціальних позначень."
>
  <div class="container section">
    <div class="container-narrow">
      <h1>Словник</h1>
      <p class="text-secondary" style="font-size: var(--text-lg);">
        Термінологічний довідник, тлумачення понять, абревіатур та історичних найменувань.
      </p>

      <div class="surface-subtle" style="margin-top: var(--space-xl); display: inline-block;">
        <p style="margin: 0; color: var(--color-accent); font-weight: var(--weight-medium);">
          Розділ у розробці
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
